EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required for Stripe payment sheet (src/app/_layout.tsx)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Required for Google Maps (app.config.ts — embedded into the Android build)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Production and staging secrets (live Stripe key, production Supabase URL, etc.)
# are managed via the EAS dashboard — do NOT commit them here.
# See: https://docs.expo.dev/eas/environment-variables/
